<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="realsense_camera">
    <static>true</static>
    <link name="camera_link">
      <inertial>
        <mass>0.072</mass>
        <inertia>
          <ixx>0.00004</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.00004</iyy>
          <iyz>0.0</iyz>
          <izz>0.00004</izz>
        </inertia>
      </inertial>

      <!-- RealSense RGB-D Sensor: outputs RGB, Depth, CameraInfo, and PointCloud -->
      <sensor name="realsense_d435" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <topic>camera</topic>
        <visualize>true</visualize>
        <camera>
          <horizontal_fov>1.2043</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>10.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.05</near>
              <far>10.0</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
